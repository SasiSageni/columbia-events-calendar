{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/events.mjs": {
      "includeFiles": "public/data/events.json"
    },
    "api/refresh-events.mjs": {
      "includeFiles": [
        "scripts/**",
        "public/data/events.json"
      ],
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/data/events.json",
      "destination": "/api/events"
    }
  ]
}
